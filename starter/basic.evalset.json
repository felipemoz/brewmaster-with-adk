      "conversation": [
        {
          "invocation_id": "turn-1",
          "user_content": {
            "parts": [
              {
                "text": "Minha água tem 20 ppm de cálcio, 15 ppm de sulfato e 20 ppm de cloreto. Como ajusto o perfil de água para uma American IPA?"
              }
            ],
            "role": "user"
          },
          "final_response": {
            "parts": [
              {
                "text": "Para uma American IPA, recomenda-se elevar a relação Sulfato:Cloreto para cerca de 3.5:1 (200-250 ppm de SO4 e 50-70 ppm de Cl) adicionando Gipso (CaSO4) e Cloreto de Cálcio (CaCl2)."
              }
            ],
            "role": "model"
          },
          "intermediate_data": {
            "tool_uses": [
              {
                "name": "ajustar_perfil_agua",
                "args": {
                  "estilo": "American IPA",
                  "calcio_ppm": 20,
                  "sulfato_ppm": 15,
                  "cloreto_ppm": 20
                }
              }
            ]
          }
        }
      ],
      "session_input": {
        "app_name": "app",
